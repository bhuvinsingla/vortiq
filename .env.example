# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Email address where contact form submissions should be delivered
# (On Resend's free/unverified tier, this must match your Resend account email)
CONTACT_TO_EMAIL=

# Optional: Verified sender address once you add a custom domain in Resend
# Defaults to: Vortiq Website <onboarding@resend.dev>
# CONTACT_FROM_EMAIL=Vortiq <contact@yourdomain.com>

